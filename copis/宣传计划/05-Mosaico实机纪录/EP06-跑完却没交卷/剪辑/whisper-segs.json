[
 {
  "start": 0.0,
  "end": 3.68,
  "text": "上一集他卡在郊卷 整晚沒回話"
 },
 {
  "start": 3.68,
  "end": 5.88,
  "text": "這次我沒急著碰他"
 },
 {
  "start": 5.88,
  "end": 8.24,
  "text": "現在電腦上寫了這句探真"
 },
 {
  "start": 8.24,
  "end": 11.64,
  "text": "探真很課質 指問能幹不能幹"
 },
 {
  "start": 11.64,
  "end": 14.08,
  "text": "不懂文件 也不從跑倒出"
 },
 {
  "start": 14.08,
  "end": 16.12,
  "text": "他指查 不動手"
 },
 {
  "start": 16.12,
  "end": 18.24,
  "text": "三組跑下來 全過"
 },
 {
  "start": 18.24,
  "end": 21.88,
  "text": "屏幕上 最後那句我盯著看了半天"
 },
 {
  "start": 21.88,
  "end": 25.96,
  "text": "主機驗證通過 設備運行時還沒驗證"
 },
 {
  "start": 25.96,
  "end": 28.88,
  "text": "說白了 電腦這邊我拿準了"
 },
 {
  "start": 28.88,
  "end": 31.04,
  "text": "真機那邊還是空白"
 },
 {
  "start": 31.04,
  "end": 33.72,
  "text": "慢一點不怕 怕的是瞎事"
 },
 {
  "start": 33.72,
  "end": 36.72,
  "text": "下一集把探真送進設備"
 }
]